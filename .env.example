# Copy this file to .env and fill in real values. Never commit .env.

# --- Vault ---
# Absolute path on disk where your markdown files + attachments live.
VAULT_DIR=/opt/scrinium/vault

# --- Auth (Better Auth) ---
# Random 32+ char string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The public URL this app is served at (used for OAuth redirect construction)
BETTER_AUTH_URL=https://scrinium.yourdomain.com

# --- Google OAuth ---
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there:
#   https://scrinium.yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Access control ---
# Comma-separated list of the ONLY email addresses allowed to log in.
# This is what actually gates access - the OAuth screen alone is not enough
# since your subdomain is publicly resolvable DNS.
ALLOWED_EMAILS=you@gmail.com

# --- Database ---
# SQLite file for auth sessions + note metadata cache. Fine for single-user.
DATABASE_PATH=/opt/scrinium/data/scrinium.db
