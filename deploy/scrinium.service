# Copy to /etc/systemd/system/scrinium.service on your VPS, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scrinium
#
# Adjust User, WorkingDirectory and paths to match where you deployed the
# built app (see README "Deploying to your VPS").

[Unit]
Description=Scrinium
After=network.target

[Service]
Type=simple
User=scrinium
WorkingDirectory=/opt/scrinium/app
EnvironmentFile=/opt/scrinium/app/.env
Environment=PORT=3000
# adapter-node rejects bodies over 512K by default. Attachments stream to
# disk and cap themselves at 100 MB, so this only needs to sit above that.
Environment=BODY_SIZE_LIMIT=101M
ExecStart=/usr/bin/node build/index.js
Restart=on-failure
RestartSec=5
MemoryMax=500M

[Install]
WantedBy=multi-user.target
